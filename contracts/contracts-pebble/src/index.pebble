
// TRACE Pharmaceutical Supply Chain Validator
// Pebble port of contracts-aiken/validators/pharma_trace.ak
//
// -----------------------------------------------------------------------------
// Canonical ABI — both Aiken and Pebble MUST match these indices.
// Mint:  InitCounter=0  MintBatch=1  Burn=2
// Spend: Transfer=0     Deliver=1    IncrementCounter=2
// Datum: ChainOfCustody=0  MintCounter=1
// Pebble assigns Constr indices by method/variant declaration order. Do NOT reorder.
// -----------------------------------------------------------------------------

struct ContractDatum {
    ChainOfCustody {
        manufacturer: PubKeyHash,
        current_holder: PubKeyHash,
        batch_id: bytes,
        step: int
    }
    // Counter datum carries only the running index. The manufacturer identity is
    // the script parameter `this.manufacturer` (cryptographically bound via the
    // parameterized script hash) — read it directly; no datum replication.
    MintCounter{
        n: int
    }
}

contract PharmaTrace {
    param manufacturer: PubKeyHash;
    param seed: TxOutRef;

    // Method declaration order MUST match Aiken MintAction constructors:
    //   InitCounter=0, MintBatch=1, Burn=2.
    // Pebble compiler assigns redeemer Constr indices by source order.

    mint initCounter() {
        const { tx, policy } = context;

        assert tx.inputs.some(({ ref }) => ref == this.seed);

        // 0.3.x: `Value` is an opaque native (no `tx.mint[policy]` enumeration).
        // Query the known empty counter name directly. Aiken still enforces
        // "exactly one token under the policy"; this port checks only the named
        // token (0.3.x `Value` has no enumeration, only `amountOf`).
        assert tx.mint.amountOf( policy, # ) == 1;

        // Counter MUST be the first output. Change (and any other non-counter
        // outputs) are unrestricted and may follow. Matches Aiken behaviour.
        const { address, value, datum } = tx.outputs[0];
        assert address.payment.hash() == policy;
        assert value.amountOf( policy, # ) == 1;
        const InlineDatum{ datum: MintCounter{ n } as ContractDatum } = datum;
        assert n == 0;
        // Manufacturer identity is bound by the script parameter (seed control at
        // init); the counter datum stores only the index.
    }

    // Mint: manufacturer mints exactly 1 NFT per batch
    // tokenName (= batchId) passed as redeemer for on-chain verification
    mint mintBatch( counterInputIdx: int ) {
        const { tx, policy } = context;

        const counterInput = tx.inputs[ counterInputIdx ].resolved;

        // forward validation to the spending of the counter utxo
        // see incrementCounter method below
        assert counterInput.address.payment.hash() == policy;
        assert counterInput.value.amountOf( policy, # ) == 1;
    }

    // allow assets under this policy to be burned at any time by anyone
    mint burn() {
        const { tx, policy } = context;

        // 0.3.x `Value` cannot be enumerated, so the exhaustive "every token
        // under this policy is negative" check lives in Aiken (the on-chain
        // authority). Here we conservatively forbid (re)minting the counter
        // token via the burn path; batch-token burn quantities are gated
        // on-chain by Aiken (0.3.x `Value` is not enumerable here).
        assert tx.mint.amountOf( policy, # ) <= 0;
    }

    // Spend: transfer custody to next holder
    spend transfer( inputIdx: int, outputIdx: int) {
        const {
            tx,
            optionalDatum: Some{
                value: ChainOfCustody{
                    manufacturer,
                    current_holder,
                    batch_id,
                    step
                } as ContractDatum
            }
            spendingRef
        } = context;

        const { ref: ownInputRef, resolved: ownInput } = tx.inputs[ inputIdx ];
        assert spendingRef == ownInputRef;

        const ownHash = ownInput.address.payment.hash();

        // Current holder must sign
        assert tx.requiredSigners.includes( current_holder );

        // we require the output to be the first
        const output = tx.outputs[outputIdx];
        const InlineDatum{ datum: ChainOfCustody{
            manufacturer: nextManufacturer,
            current_holder: nextHolder,
            batch_id: nextBatchId,
            step: nextStep
        } as ContractDatum } = output.datum;

        assert nextManufacturer == manufacturer;
        assert nextHolder.length() == 28; // must be a valid pubkey hash
        assert nextBatchId == batch_id; // same batch
        assert nextStep == step + 1; // step must be incremented by 1

        // stays in contract
        assert output.address.payment.hash() == ownHash;

        // preserve nft
        assert output.value.amountOf( ownHash, batch_id ) == 1;
    }

    // Spend: deliver — NFT leaves script address to holder's wallet
    // No continuing output check needed
    spend deliver() {
        const {
            tx,
            optionalDatum: Some{
                value: ChainOfCustody{ current_holder } as ContractDatum
            }
        } = context;

        assert tx.requiredSigners.includes(current_holder);
    }

    // Spend the counter UTxO + mint exactly ONE batch NFT in one atomic tx.
    // Single-batch-per-tx (0.3.x): `Value` is no longer enumerable, so the old
    // `tx.mint[ownHash]` loop over k batches is gone -- the batch name is fixed
    // to int_to_bytes(n+1) and checked by `amountOf`. Output[0] = updated
    // counter, Output[1] = the batch NFT. Mirrors Aiken can_increment_counter.
    spend incrementCounter( ownInputIdx: int ) {
        const {
            tx,
            optionalDatum: Some{
                value: MintCounter{ n: prevCounter } as ContractDatum
            },
            spendingRef
        } = context;

        assert tx.requiredSigners.includes( this.manufacturer );

        const { ref: ownInputRef, resolved: ownInput } = tx.inputs[ ownInputIdx ];
        assert spendingRef == ownInputRef;
        const ownHash = ownInput.address.payment.hash();
        assert ownInput.value.amountOf( ownHash, # ) == 1;

        const nextCounter = prevCounter + 1;
        const batchName = nextCounter as bytes;

        // Exactly this one batch token minted (Aiken also enforces "no others").
        assert tx.mint.amountOf( ownHash, batchName ) == 1;

        // Counter output at [0] -- token preserved, datum advanced to n+1.
        const { address: ncAddr, value: ncValue, datum: ncDatum } = tx.outputs[0];
        assert ncAddr.payment.hash() == ownHash;
        assert ncValue.amountOf( ownHash, # ) == 1;
        const InlineDatum{ datum: MintCounter{ n: next } as ContractDatum } = ncDatum;
        assert next == nextCounter;

        // Batch output at [1] -- NFT present, ChainOfCustody datum at step 0.
        const { address: bAddr, value: bValue, datum: bDatum } = tx.outputs[1];
        assert bAddr.payment.hash() == ownHash;
        assert bValue.amountOf( ownHash, batchName ) == 1;
        const InlineDatum{ datum: ChainOfCustody{
            manufacturer: bMfr,
            current_holder: bHolder,
            batch_id: bId,
            step: bStep
        } as ContractDatum } = bDatum;
        assert bMfr == this.manufacturer;
        assert bHolder == this.manufacturer;
        assert bId == batchName;
        assert bStep == 0;
    }
}